# ===== POPULOVE 環境變數（範例）=====
# 使用方式：複製本檔為 .env.local，再填入實際值。
# .env.local 已被 .gitignore 忽略，請勿把實際金鑰提交到版控。
#
# ---- Supabase 雲端同步（P7）----
# 前台與後台讀雲端用的公開金鑰（可放前端，加 NEXT_PUBLIC_ 前綴）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# 僅伺服器端使用的秘密金鑰：用於後台存檔寫入雲端。
# 切勿加上 NEXT_PUBLIC_ 前綴、切勿外洩、切勿提交。
SUPABASE_SECRET_KEY=
#
# ---- 後台登入 Session ----
# 用來簽署後台登入 cookie 的隨機字串（建議 32 bytes 以上的隨機 hex）。
# 僅伺服器端使用，切勿外洩。
ADMIN_SESSION_SECRET=
